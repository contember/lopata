{
	"name": "browser-run-vite",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-12",
	"browser": { "binding": "BROWSER" },
	"services": [{ "binding": "AUX", "service": "browser-run-vite-aux" }],
	"durable_objects": {
		"bindings": [
			{ "name": "INSPECTOR", "class_name": "SessionInspector" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SessionInspector"] }
	]
}
